# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys (the encryption key lives in .dev.vars or secrets.env; see docs/secrets.env.example)
.env*
.dev.vars*
secrets.env
*.env
*.env.new
*.pem
*.key
*.pfx

# Data that must never be committed: databases (and their -wal/-shm/-journal files), backups, logs
*.sqlite
*.sqlite3
*.sqlite-*
*.db
*.db-*
/backups/
/logs/
*.log

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store
# Generated local document-reader assets and test fixtures
/public/invoice-tools/
/tmp/

/.openai/
/reference.json

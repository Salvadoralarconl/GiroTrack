# Example only — placeholders, no real values. The real file is created by
# `pnpm run local:setup` (development: .dev.vars; server: the path in
# GIROTRACK_SECRETS_FILE, e.g. C:\ProgramData\GiroTrack\secrets.env) and must never be committed.

# Required. Base64 of 32 random bytes. Created for you by local:setup; never replace it
# while encrypted passwords exist (use scripts/vault-keys.mjs to rotate).
GIROTRACK_VAULT_KEY=<generated by pnpm run local:setup>

# Set by scripts/vault-keys.mjs during a key rotation; leave out otherwise.
# GIROTRACK_VAULT_KEY_ID=2
# GIROTRACK_VAULT_OLD_KEYS=1:<previous key>

# Server only: the HTTPS address employees open (behind IIS).
# GIROTRACK_PUBLIC_ORIGIN=https://girotrack.girosol.local

# Server only: at least 32 random characters, the same value IIS sends as X-GiroTrack-Proxy.
# GIROTRACK_PROXY_SECRET=<long random value>
